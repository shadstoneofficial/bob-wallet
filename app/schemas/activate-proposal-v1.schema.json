{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learnhns.com/schemas/activate-proposal-v1.schema.json",
  "title": "LearnHNS activation proposal v1",
  "description": "A non-custodial request for a wallet or DNS manager to review and apply named record operations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "kind", "version", "source", "target", "canonicalResource", "operations", "preservation"],
  "properties": {
    "$schema": { "const": "https://learnhns.com/schemas/activate-proposal-v1.schema.json" },
    "kind": { "const": "activate-proposal" },
    "version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "origin", "generatedAt"],
      "properties": {
        "application": { "const": "learnhns-web" },
        "origin": { "const": "https://learnhns.com/activate/" },
        "generatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "network", "publishingLayer"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" },
        "network": { "enum": ["main", "testnet", "regtest", "simnet"] },
        "publishingLayer": { "enum": ["handshake-onchain", "authoritative-zone"] }
      }
    },
    "canonicalResource": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "encoding", "value", "requirement"],
          "properties": {
            "source": { "const": "handshake-chain" },
            "encoding": { "const": "hex" },
            "value": { "type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^(?:[0-9a-f]{2})+$" },
            "requirement": { "const": "exact-match" }
          }
        }
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "recordType", "value"],
            "properties": {
              "op": { "const": "set-address" },
              "recordType": { "enum": ["SYNTH4", "SYNTH6", "A", "AAAA"] },
              "value": { "type": "string", "minLength": 2, "maxLength": 45 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "key", "value"],
            "properties": {
              "op": { "const": "upsert-hnsbio-txt" },
              "key": { "enum": ["name", "bio", "pfp", "link", "mail", "x", "gh", "hns", "btc"] },
              "value": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        ]
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": { "strategy": { "const": "preserve-unmentioned" } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "target": { "properties": { "publishingLayer": { "const": "handshake-onchain" } }, "required": ["publishingLayer"] } } },
      "then": { "properties": { "canonicalResource": { "type": "object" } } },
      "else": { "properties": { "canonicalResource": { "type": "null" } } }
    }
  ]
}
